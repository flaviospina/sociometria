# Sociometria Escolar — exemplo de configuração. NÃO coloque segredos reais neste arquivo.
APP_NAME="Sociometria Escolar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Banco de controle (runtime) -------------------------------------------
DB_DRIVER=mariadb            # mysql (MySQL 8) ou mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sociometria_control
DB_USERNAME=soc_control
DB_PASSWORD=

# --- Tenants ----------------------------------------------------------------
# Credencial de PROVISIONAMENTO (cria bancos/contas e roda migrations de tenant).
TENANT_PROVISIONER_USERNAME=soc_provisioner
TENANT_PROVISIONER_PASSWORD=
TENANT_DB_PREFIX=soc_t_
TENANT_DB_USER_PREFIX=soc_u_
TENANT_DB_USER_HOST=localhost
TENANT_DB_MAX_USER_CONNECTIONS=10
PLATFORM_HOSTS=localhost,127.0.0.1

# --- Segurança --------------------------------------------------------------
SECURITY_MFA_REQUIRED=true
TRUSTED_PROXIES=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false   # true em homologação/produção (HTTPS obrigatório)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"
