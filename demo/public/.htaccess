# demo/public/.htaccess
Options -Indexes
# Esta é a única pasta que pode ser acessada pela internet
# (a pasta acima dela nega tudo no próprio .htaccess).
Require all granted
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

# Bloqueia arquivos ocultos e de configuração que venham a parar aqui por engano
<FilesMatch "^\.|\.(env|sql|md|log|ini)$">
  Require all denied
</FilesMatch>
